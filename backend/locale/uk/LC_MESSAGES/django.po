#: users/schema.py:12 users/schema.py:13
msgid "Authenticate a user with provided credentials"
msgstr "Автентифікація користувача"

#: users/schema.py:29 users/schema.py:30
msgid "Logout the current user"
msgstr "Вийти з акаунту користувача"

#: users/schema.py:45 users/schema.py:46
msgid "Send a password reset link to a user"
msgstr "Надіслати посилання для скидання паролю користувачеві"

#: users/schema.py:61 users/schema.py:62
msgid "Reset user password via confirmation link"
msgstr "Скинути пароль користувача через підтверджувальне посилання"

#: users/schema.py:77 users/schema.py:78
msgid "Change the password of the current user"
msgstr "Змінити пароль користувача"

#: users/schema.py:93 users/schema.py:94
msgid "Register a new user"
msgstr "Зареєструвати нового користувача"

#: users/schema.py:109 users/schema.py:110
msgid "Verify user email via confirmation link"
msgstr "Підтвердити email користувача за допомогою підтверджувального посилання"

#: users/schema.py:125 users/schema.py:126
msgid "Resend another email verification letter"
msgstr "Повторно надіслати лист для підтвердження email"

#: users/schema.py:141 users/schema.py:142
msgid "Verify the provided JWT token"
msgstr "Перевірити наданий JWT токен"

#: users/serializers.py:48
msgid "This username is already taken."
msgstr "Це ім'я користувача вже зайняте."

#: users/serializers.py:63
msgid "Failed to get request object."
msgstr "Не вдалось отримати request об'єкт."

#: users/serializers.py:72
msgid "This e-mail address is already in use."
msgstr "Цей e-mail вже використовується."

#: users/serializers.py:76
msgid "This e-mail address is already taken."
msgstr "Цей e-mail вже зайнятий."

#: users/views.py:34 users/views.py:35
msgid "Get the current user details"
msgstr "Отримати інформацію про поточного користувача"

#: users/views.py:38 users/views.py:39
msgid "Update the current user details"
msgstr "Оновити інформацію поточного користувача"

#: users/views.py:42 users/views.py:43
msgid "Partially update the current user details"
msgstr "Частково оновити інформацію поточного користувача"

#: users/views.py:46 users/views.py:47
msgid "Delete the current user with password confirmation"
msgstr "Видалити поточного користувача з підтвердженням паролю"

#: users/views.py:60
msgid "This field is required."
msgstr "Це поле обов'язкове до заповнення."

#: users/views.py:68
msgid "Failed to authenticate with provided credentials."
msgstr "Не вдалося автентифікувати користувача."

#: users/views.py:86 users/views.py:89
msgid "Redirect a user to the frontend to confirm email verification"
msgstr "Перенаправити користувача у фронтенд для підтвердження email"

#: users/views.py:97
msgid "Email verification key"
msgstr "Ключ для підтвердження email"

#: users/views.py:117 users/views.py:120
msgid "Redirect a user to the frontend to confirm password reset"
msgstr "Перенаправити користувача у фронтенд для скидання паролю"

#: users/views.py:128
msgid "Password reset token"
msgstr "Токен для скидання паролю"

#: users/views.py:134
msgid "User ID"
msgstr "ID користувача"

#: users/views.py:153 users/views.py:154
msgid "Authenticate a user with Google social auth"
msgstr "Автентифікація через Google"

#: users/views.py:166 users/views.py:167
msgid "Change the current user email"
msgstr "Змінити email користувача"

#: users/views.py:185
msgid "Verification e-mail sent."
msgstr "Було надіслано лист для підтвердження email."

#: users/views.py:198 users/views.py:199
msgid "Fetch all the links of the current user"
msgstr "Вивести всі посилання поточного користувача"

#: users/views.py:209
msgid "Search string for filtering"
msgstr "Рядок для фільтрації"

#: users/views.py:234 users/views.py:235
msgid "Fetch the current user statistics"
msgstr "Вивести статистику користувача"

